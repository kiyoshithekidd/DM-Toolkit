; PICA200 Vertex Shader for 3D Hardware-Lit Dice
.fvec projection[4], modelView[4]
.constf myconst(0.0, 1.0, 0.001, 0.0)

; Outputs
.out outpos position
.out outnq  normalquat
.out outview view
.out outcol color

; Inputs (v0 = position, v1 = normal)
.alias inpos v0
.alias innrm v1

.entry vmain
.proc vmain
	; Transform position to view space
	mov r0.xyz, inpos
	mov r0.w, myconst.y
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; View vector = -viewPos
	mov outview, -r1

	; Transform to clip space
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; Transform normal to view space
	dp3 r2.x, modelView[0], innrm
	dp3 r2.y, modelView[1], innrm
	dp3 r2.z, modelView[2], innrm
	dp3 r2.w, r2, r2
	rsq r2.w, r2.w
	mul r2.xyz, r2.xyz, r2.w

	; Pack view-space normal into quaternion (nx, ny, nz) -> normalquat
	add r3.w, myconst.y, r2.z
	max r3.w, r3.w, myconst.z
	mov r3.x, -r2.y
	mov r3.y, r2.x
	mov r3.z, myconst.x
	dp4 r4.x, r3, r3
	rsq r4.x, r4.x
	mul outnq, r3, r4.x

	mov outcol, myconst.y
	end
.end
